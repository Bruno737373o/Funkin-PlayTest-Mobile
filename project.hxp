import lime.tools.Project;
import haxe.io.Path;

/**
 * Friday Night Funkin' PlayTest Mobile build configuration.
 * Configured for Android platform 35, NDK 27.2, and ARM64 release builds.
 */
class Project extends lime.tools.Project
{
  public function new()
  {
    super();

    meta.title = "Friday Night Funkin': PlayTest Mobile";
    meta.packageName = "com.funkin.playtest";
    meta.version = "0.8.5.1";
    meta.company = "The Funkin' Crew";

    app.main = "funkin.InitState";
    app.file = "FunkinPlayTest";

    window.width = 1280;
    window.height = 720;
    window.fps = 60;
    window.background = 0x000000;
    window.hardware = true;
    window.vsync = false;

    // ==========================================
    // Core Feature Flags
    // ==========================================

    // FEATURE_DEBUG_MENU: Enables debug menu in game options, charting tools, and dev shortcuts
    haxedefs.set("FEATURE_DEBUG_MENU", "1");
    setDefine("FEATURE_DEBUG_MENU");

    // Mobile touch and playtest features
    haxedefs.set("FEATURE_TOUCH_CONTROLS", "1");
    setDefine("FEATURE_TOUCH_CONTROLS");
    haxedefs.set("FEATURE_MOBILE_PLAYTEST", "1");
    setDefine("FEATURE_MOBILE_PLAYTEST");
    haxedefs.set("mobile", "1");
    setDefine("mobile");
    haxedefs.set("android", "1");
    setDefine("android");

    // Android Target Specification (matches GitHub Actions CI workflow)
    #if android
    targetFlags.set("arm64", true);
    #end

    #if GITHUB_BUILD
    haxedefs.set("GITHUB_BUILD", "1");
    setDefine("GITHUB_BUILD");
    #end

    // Path definitions
    sources.push("source");
    includeAssets("assets", "assets");
  }
}
